{
  "name": "lumora",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "npm run test:build && node --test tests/ai/*.test.mjs tests/security/policies.test.mjs",
    "test:isolation": "node tests/security/isolation.mjs && node tests/security/isolation-curriculum.mjs && node tests/security/isolation-curriculum-invoker.mjs",
    "verify": "npm run type-check && npm run test",
    "lint": "next lint",
    "test:build": "sh build-tests.sh",
    "test:canary": "node tests/security/canary.mjs",
    "test:evidence": "node tests/security/evidence.mjs",
    "test:smoke": "playwright test --config=playwright.config.mjs",
    "security:restore": "node tests/security/restore.mjs",
    "test:security:open": "node tests/security/open-cases.mjs",
    "audit:ci": "npm audit --registry=https://registry.npmjs.org --audit-level=high"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.104",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.47.10",
    "ai": "7.0.155",
    "next": "14.2.35",
    "next-intl": "3.26.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.1",
    "esbuild": "0.24.2",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
