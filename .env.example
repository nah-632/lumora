# AI teacher tools — server-only. Never prefix these with NEXT_PUBLIC_.
# Leave empty to show the "unavailable" state instead of calling a provider.

# OpenAI-compatible endpoint. Defaults to the Hugging Face router.
AI_BASE_URL=
# Model id served by that endpoint.
AI_MODEL=
# Provider key. Either name is read; AI_API_KEY wins if both are set.
AI_API_KEY=
HUGGINGFACE_API_KEY=
