# LUMORA environment — copy to .env.local and fill in your own values.
# Never commit real keys. The service_role key must never be exposed to a client.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by CLI tasks and maintenance, never by request handlers.
SUPABASE_SERVICE_ROLE_KEY=
# Read from process.env by migration/repair scripts; do not paste into any file
# that is committed.
SUPABASE_DB_PASSWORD=

# --- AI provider ---
# Leave empty to show the "not configured" state rather than canned output.
AI_PROVIDER=
AI_API_KEY=
