# LUMORA — environment template (copy to .env.local)
PGHOST=/var/run/postgresql
PGDATABASE=lumora
PGUSER=lumora_user
PGPASSWORD=lumora_pw_dev

# Feature flags (unverified capabilities stay OFF until confirmed)
FEATURE_PAYMENTS=false
FEATURE_WHATSAPP=false
FEATURE_REVIEWS=false

# Public site (fill from verified business config only)
NEXT_PUBLIC_SITE_URL=https://lumora.bh
NEXT_PUBLIC_DEFAULT_LOCALE=ar
