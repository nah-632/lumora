# AI teacher tools — server-only. Never prefix these with NEXT_PUBLIC_.
# Leave empty to show the "unavailable" state instead of calling a provider.

# OpenAI-compatible endpoint. Defaults to the Hugging Face router.
AI_BASE_URL=
# Model id served by that endpoint.
AI_MODEL=
# Provider key. Either name is read; AI_API_KEY wins if both are set.
AI_API_KEY=
HUGGINGFACE_API_KEY=

# ---- Auth email links ----
# Where a confirmation or recovery link comes back to. Absolute, no trailing slash.
NEXT_PUBLIC_SITE_URL=
# Comma-separated allow-list of origins an email link may return to. The request's
# Host header is only honoured when it appears here, so a forged Host cannot point
# a recovery link at another domain. Add each preview and production origin.
# Example: https://lumora.example,https://lumora-git-main-team.vercel.app
AUTH_ALLOWED_ORIGINS=
