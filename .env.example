# SERVO environment — local dev (values are non-secret dev defaults)
# Copy to .env.local for real values.
DATABASE_URL=postgres://servo_user:servo_pw_dev@/servo?host=/var/run/postgresql
PGHOST=/var/run/postgresql
PGDATABASE=servo
PGUSER=servo_user
PGPASSWORD=servo_pw_dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Feature flags (§3: unverified capabilities off by default)
FEATURE_PAYMENTS=false
FEATURE_WHATSAPP=false
FEATURE_REVIEWS=false
FEATURE_BLOG=false
FEATURE_PROMOTIONS=false
FEATURE_PROVIDER_ACCOUNTS=false
